<mxfile host="app.diagrams.net" agent="pathogensportal-db docs" version="24.7.5"><diagram id="overview" name="overview"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2050" pageHeight="990" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="pathogensportal-db — overview: data and metadata in one picture" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1400" height="40" as="geometry"/></mxCell><mxCell id="lane_d" value="DATA — what the numbers are" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#f3f8fd;strokeColor=#9db7d1;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontFamily=Helvetica;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="24" y="150" width="1990" height="400" as="geometry"/></mxCell><mxCell id="lane_m" value="METADATA — what the numbers mean and where they come from" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#fdf3f2;strokeColor=#dba5a1;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontFamily=Helvetica;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="24" y="570" width="1300" height="330" as="geometry"/></mxCell><mxCell id="trig" value="&lt;b&gt;What starts a run&lt;/b&gt;&lt;br&gt;push to &lt;b&gt;dev&lt;/b&gt; → GitHub Action &lt;i&gt;trigger-datapipeline&lt;/i&gt; → the dev server builds the &lt;b&gt;datascrapper&lt;/b&gt; image from this repo and runs it: run_all.py → generate_json.py → detect_anomalies.py → compute_mem.py. Production uses the release tag the portal pins." style="shape=note;size=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1500" height="62" as="geometry"/></mxCell><mxCell id="src" value='&lt;b&gt;10 open data sources&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;br&gt;&lt;b&gt;Czech surveillance&lt;/b&gt;&lt;br&gt;MZČR — COVID-19&lt;br&gt;ÚZIS — ISIN (notifiable diseases)&lt;br&gt;ÚZIS — RPN + RTBC registries&lt;br&gt;SZÚ — seasonal + weekly flu PDFs&lt;br&gt;ČSÚ — population&lt;br&gt;&lt;br&gt;&lt;b&gt;International context&lt;/b&gt;&lt;br&gt;WHO — FluNet + FluID&lt;br&gt;ECDC — ERVISS&lt;br&gt;ECDC — RespiCast forecasts&lt;br&gt;ECDC — COVID-19 (frozen)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="44" y="200" width="250" height="320" as="geometry"/></mxCell><mxCell id="scr" value='&lt;b&gt;① run_all.py&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;br&gt;10 scrapers in&lt;br&gt;scripts/scrapers/&lt;br&gt;&lt;br&gt;each one isolated:&lt;br&gt;a failing source does&lt;br&gt;not stop the others&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="360" y="270" width="210" height="180" as="geometry"/></mxCell><mxCell id="csv" value='&lt;b&gt;$DATA_DIR/&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&amp;lt;source&amp;gt;/*.csv&lt;br&gt;&lt;br&gt;plain files are the&lt;br&gt;hand-over between phases&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="300" width="190" height="120" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#36546b;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="src" target="scr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#36546b;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="scr" target="csv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="snap" value='&lt;b&gt;② snapshot.py&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;gzip + sha256 dedup&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="900" y="196" width="150" height="60" as="geometry"/></mxCell><mxCell id="arch" value='&lt;b&gt;$DATA_DIR/raw/&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;dated archive + manifest&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1090" y="196" width="170" height="60" as="geometry"/></mxCell><mxCell id="load" value='&lt;b&gt;③ load_to_db.py&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;optional, UPSERT&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="900" y="466" width="150" height="60" as="geometry"/></mxCell><mxCell id="db" value='&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;observation&lt;br&gt;population&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#4d7c3f;" vertex="1" parent="1"><mxGeometry x="1090" y="456" width="170" height="80" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#7a7a7a;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="csv" target="snap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#7a7a7a;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="csv" target="load"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#7a7a7a;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="snap" target="arch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#7a7a7a;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="load" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="gen" value='&lt;b&gt;④ ⑤ generators&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;br&gt;&lt;b&gt;generate_json.py&lt;/b&gt;&lt;br&gt;one JSON file per chart&lt;br&gt;&lt;br&gt;&lt;b&gt;detect_anomalies.py&lt;/b&gt;&lt;br&gt;early-warning signals (ISIN)&lt;br&gt;&lt;br&gt;&lt;b&gt;compute_mem.py&lt;/b&gt;&lt;br&gt;flu thresholds, trend, forecast&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1330" y="250" width="230" height="220" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#36546b;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="csv" target="gen"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#7a7a7a;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="db" target="gen"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="out" value='&lt;b&gt;$OUTPUT_DIR/&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;*.json&lt;br&gt;&lt;br&gt;labels + datasets&lt;br&gt;+ &lt;b&gt;meta&lt;/b&gt;&lt;br&gt;&lt;br&gt;anomaly_signals.json&lt;br&gt;flu_mem.json&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1630" y="290" width="170" height="140" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#36546b;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gen" target="out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="por" value='&lt;b&gt;Portal&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;br&gt;static JSON in&lt;br&gt;frontend/static/&lt;br&gt;data/charts/&lt;br&gt;&lt;br&gt;/api/charts&lt;br&gt;&lt;br&gt;Chart.js&lt;br&gt;dashboards&lt;br&gt;&lt;br&gt;MCP + AI&lt;br&gt;layer&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1860" y="220" width="140" height="280" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#36546b;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="out" target="por"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pub" value='&lt;b&gt;Publisher metadata&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;br&gt;CSVW description&lt;br&gt;NKOD (data.gov.cz)&lt;br&gt;HTTP headers&lt;br&gt;GitHub last commit&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="44" y="620" width="250" height="150" as="geometry"/></mxCell><mxCell id="sm" value='&lt;b&gt;source_metadata.py&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;br&gt;asks each publisher;&lt;br&gt;a failure is recorded,&lt;br&gt;never fatal&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="360" y="635" width="210" height="120" as="geometry"/></mxCell><mxCell id="sj" value='&lt;b&gt;$DATA_DIR/meta/&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;source_metadata.json&lt;br&gt;&lt;br&gt;licence, freshness,&lt;br&gt;periodicity, caveats&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="645" width="190" height="100" as="geometry"/></mxCell><mxCell id="cm" value='&lt;b&gt;chart_meta.py&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;br&gt;builds the meta block:&lt;br&gt;metric, unit, grain, period,&lt;br&gt;sources, caveats&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="900" y="635" width="200" height="120" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pub" target="sm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sm" target="sj"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sj" target="cm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="meta block for every chart" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.6;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="cm" target="gen"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r_src" value='&lt;b&gt;sources.yaml&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;where to look&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="360" y="810" width="150" height="66" as="geometry"/></mxCell><mxCell id="r_met" value='&lt;b&gt;methodology_changes.yaml&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;known reporting changes&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="600" y="810" width="230" height="66" as="geometry"/></mxCell><mxCell id="r_ch" value='&lt;b&gt;charts.yaml&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;what each chart measures&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="920" y="810" width="160" height="66" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.3571;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_src" target="sm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="caveats" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_met" target="sm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_ch" target="cm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n1" value="&lt;b&gt;Why two lanes&lt;/b&gt;&lt;br&gt;A chart JSON is only labels and numbers. A person reads the meaning from the page heading; a machine cannot. The metadata lane adds, to every file, what is measured, in which unit, for which period, from which source, how fresh that source is and which known reporting changes apply.&lt;br&gt;The two lanes meet in the generators: the same file carries the data and its &lt;b&gt;meta&lt;/b&gt; block." style="shape=note;size=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1540" y="580" width="470" height="170" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Contract with the portal&lt;/b&gt;&lt;br&gt;The portal consumes this repo as a git submodule pinned to a release tag. Script names, the Dockerfile CMD, DATA_DIR / OUTPUT_DIR and the path db/init.sql are the public interface — changing them is a breaking change." style="shape=note;size=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1540" y="770" width="470" height="110" as="geometry"/></mxCell><mxCell id="lg_t" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="70" height="24" as="geometry"/></mxCell><mxCell id="lg0" value="external publisher" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="110" y="930" width="150" height="26" as="geometry"/></mxCell><mxCell id="lg1" value="scrapers" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="276" y="930" width="150" height="26" as="geometry"/></mxCell><mxCell id="lg2" value="file on disk" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="442" y="930" width="150" height="26" as="geometry"/></mxCell><mxCell id="lg3" value="pipeline script" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="608" y="930" width="150" height="26" as="geometry"/></mxCell><mxCell id="lg4" value="registry (YAML)" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="774" y="930" width="150" height="26" as="geometry"/></mxCell><mxCell id="lg5" value="generated JSON" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="940" y="930" width="150" height="26" as="geometry"/></mxCell><mxCell id="lg6" value="portal side" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1106" y="930" width="150" height="26" as="geometry"/></mxCell><mxCell id="lg_x" value="dark arrows = data · red arrows = metadata · grey = archive / database · dashed = optional (one SQL join, with a CSV fallback)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1282" y="932" width="760" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
