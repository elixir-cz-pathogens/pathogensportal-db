<mxfile host="app.diagrams.net" agent="pathogensportal-db docs" version="24.7.5"><diagram id="data-flow" name="data-flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2080" pageHeight="1372" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="pathogensportal-db — data flow: from the publishers to the chart JSON" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1200" height="40" as="geometry"/></mxCell><mxCell id="bg_src" value="① Sources (publishers)" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#fafafa;strokeColor=#cccccc;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontFamily=Helvetica;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="26" y="296" width="268" height="992" as="geometry"/></mxCell><mxCell id="bg_scr" value="① Scrapers — scripts/scrapers/" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#fafafa;strokeColor=#cccccc;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontFamily=Helvetica;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="326" y="296" width="258" height="992" as="geometry"/></mxCell><mxCell id="bg_csv" value="CSV — $DATA_DIR/&amp;lt;source&amp;gt;/" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#fafafa;strokeColor=#cccccc;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontFamily=Helvetica;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="626" y="296" width="328" height="992" as="geometry"/></mxCell><mxCell id="bg_gen" value="④ ⑤ Generators — scripts/" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#fafafa;