"/></mxCell><mxCell id="s_szw" value='&lt;b&gt;SZÚ — weekly PDFs&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;“by virus type” (virus × week matrix)&lt;br&gt;“by region” (one PDF per week)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="578" width="240" height="72" as="geometry"/></mxCell><mxCell id="s_reg" value='&lt;b&gt;ÚZIS — registries RPN + RTBC&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;STIs since 1994 · tuberculosis since 2000&lt;br&gt;CSV · updated once a year&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="664" width="240" height="72" as="geometry"/></mxCell><mxCell id="s_csu" value='&lt;b&gt;ČSÚ — DataStat API&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;dataset PORKR01 · population by region&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="240" height="56" as="geometry"/></mxCell><mxCell id="s_isin" value='&lt;b&gt;ÚZIS — ISIN&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;notifiable infectious diseases&lt;br&gt;114 diagnoses × region × month × age group&lt;br&gt;one CSV · the main source of the dashboards&lt;br&gt;and of the anomaly detection&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="240" height="128" as="geometry"/></mxCell><mxCell id="s_who" value='&lt;b&gt;WHO — xMart API (FLUMART)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;FluNet: lab detections, weekly since 1997&lt;br&gt;FluID: ILI / ARI cases + population covered&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="962" width="240" height="72" as="geometry"/></mxCell><mxCell id="s_erv" value='&lt;b&gt;ECDC — ERVISS&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;GitHub CSV · weekly · since 2022-W25&lt;br&gt;ILI / ARI rates per 100,000 + lab reports&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="1048" width="240" height="72" as="geometry"/></mxCell><mxCell id="s_rc" value='&lt;b&gt;ECDC — RespiCast hub&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;GitHub · one CSV per weekly round&lt;br&gt;quantile forecasts of ILI / ARI&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="1134" width="240" height="68" as="geometry"/></mxCell><mxCell id="s_ecdc" value='&lt;b&gt;ECDC — COVID-19 daily&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;frozen since autumn 2022&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="1216" width="240" height="56" as="geometry"/></mxCell><mxCell id="s_cur" value='&lt;b&gt;curated/szu/ — in this repo&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;3 closed seasons no longer online&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillCo