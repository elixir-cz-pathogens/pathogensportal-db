t;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;signals, scores, FDR, provenance&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1360" y="890" width="300" height="58" as="geometry"/></mxCell><mxCell id="o_mem" value='&lt;b&gt;flu_mem.json&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;ILI and ARI: thresholds, seasons used,&lt;br&gt;trend, forecast, back-test results&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1360" y="1012" width="300" height="140" as="geometry"/></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#36546b;exitX=1;exitY=0.0781;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_json" target="o_covid"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#36546b;exitX=1;exitY=0.3792;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_json" target="o_flu"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#36546b;exitX=1;exitY=0.6691;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_json" target="o_reg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#36546b;exitX=1;exitY=0.881;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_json" target="o_isin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#36546b;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_anom" target="o_anom"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#36546b;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_mem" target="o_mem"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p_static" value='&lt;b&gt;frontend/static/data/charts/&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;$OUTPUT_DIR is mounted here&lt;br&gt;on dev the pipeline run commits&lt;br&gt;the refreshed JSON files&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1750" y="438" width="270" height="96" as="geometry"/></mxCell><mxCell id="p_api" value='&lt;b&gt;website-be&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;loader → table dashboard_data&lt;br&gt;→ GET /api/charts&lt;br&gt;payload identical to the static file&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1750" y="674" width="270" height="96" as="geometry"/></mxCell><mxCell id="p_js" value='&lt;b&gt;pp-charts.js + Chart.js&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;asks /api/charts first,&lt;br&gt;falls back to the static JSON&lt;br&gt;dashboards · Signals · flu intensity&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1750" y="836" width="270" height="96" as="geometry"/></mxCell><mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#36546b;exitX=1;exitY=0.1915;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bg_out" target="p_static"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#36546b;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_static" target="p_api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#36546b;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p_api" target="p_js"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t_snap" value='&lt;b&gt;② snapshot.py&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;gzip + sha256&lt;br&gt;unchanged = skipped&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="640" y="70" width="140" height="70" as="geometry"/></mxCell><mxCell id="t_load" value='&lt;b&gt;③ load_to_db.py&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;6 loaders, UPSERT&lt;br&gt;applies db/init.sql&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="800" y="168" width="140" height="76" as="geometry"/></mxCell><mxCell id="t_arch" value='&lt;b&gt;$DATA_DIR/raw/&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;&amp;lt;YYYY-MM-DD&amp;gt;/&amp;lt;source&amp;gt;/&amp;lt;file&amp;gt;.csv.gz&lt;br&gt;manifest.json (last hash + date per file)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1030" y="70" width="240" height="70" as="geometry"/></mxCell><mxCell id="t_db" value='&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;observation (one shape for all sources)&lt;br&gt;population (denominators)&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#4d7c3f;" vertex="1" parent="1"><mxGeometry x="1030" y="164" width="240" height="84" as="geometry"/></mxCell><mxCell id="e43" value="every downloaded file" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#7a7a7a;exitX=0.2561;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="bg_csv" target="t_snap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e44" value="files marked ◆" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#7a7a7a;exitX=0.7439;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="bg_csv" target="t_load"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#7a7a7a;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_snap" target="t_arch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#7a7a7a;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_load" target="t_db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#7a7a7a;dashed=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_db" target="g_json"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t_note" value="&lt;b&gt;How a run is ordered&lt;/b&gt;&lt;br&gt;&lt;b&gt;run_all.py&lt;/b&gt; calls the scrapers one by one (each isolated in try/except — one failing source does not stop the others), then snapshot.py, then source_metadata.py.&lt;br&gt;The container then runs &lt;b&gt;generate_json.py → detect_anomalies.py → compute_mem.py&lt;/b&gt;.&lt;br&gt;&lt;b&gt;load_to_db.py&lt;/b&gt; is a separate step, not part of the container command. generate_json.py uses the database for one cross-source join (isin_regional_incidence) and falls back to the CSV files when it is not reachable (dashed arrow).&lt;br&gt;detect_anomalies.py &lt;code&gt;--as-of&lt;/code&gt; can re-run on an archived ISIN snapshot from raw/." style="shape=note;size=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1360" y="70" width="660" height="150" as="geometry"/></mxCell><mxCell id="lg_t" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="1312" width="120" height="24" as="geometry"/></mxCell><mxCell id="lg0" value="external publisher" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="110" y="1312" width="140" height="26" as="geometry"/></mxCell><mxCell id="lg1" value="scraper" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="266" y="1312" width="140" height="26" as="geometry"/></mxCell><mxCell id="lg2" value="file on disk" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="422" y="1312" width="140" height="26" as="geometry"/></mxCell><mxCell id="lg3" value="pipeline script" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="578" y="1312" width="140" height="26" as="geometry"/></mxCell><mxCell id="lg4" value="generated JSON" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="734" y="1312" width="140" height="26" as="geometry"/></mxCell><mxCell id="lg5" value="portal side" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="890" y="1312" width="140" height="26" as="geometry"/></mxCell><mxCell id="lg_x" value="◆ = also loaded into PostgreSQL by load_to_db.py &amp;nbsp;·&amp;nbsp; dashed arrow = optional path &amp;nbsp;·&amp;nbsp; circled numbers = pipeline phases (① download ② archive ③ normalise ④ charts ⑤ analytics)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1056" y="1308" width="980" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
