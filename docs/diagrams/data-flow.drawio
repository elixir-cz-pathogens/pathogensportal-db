e=12;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="664" width="230" height="72" as="geometry"/></mxCell><mxCell id="c_csu" value='&lt;b&gt;csu_population.py&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;region names → NUTS3 codes&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="750" width="230" height="56" as="geometry"/></mxCell><mxCell id="c_isin" value='&lt;b&gt;uzis_isin.py&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;plain file download, no transformation&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="820" width="230" height="128" as="geometry"/></mxCell><mxCell id="c_who" value='&lt;b&gt;who_flu.py&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;filter COUNTRY_CODE = CZE, rename columns&lt;br&gt;freshness guard: 45 days / 180 days&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="962" width="230" height="72" as="geometry"/></mxCell><mxCell id="c_erv" value='&lt;b&gt;ecdc_erviss.py&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;filter countryname = Czechia&lt;br&gt;freshness guard: 45 days&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="1048" width="230" height="72" as="geometry"/></mxCell><mxCell id="c_rc" value='&lt;b&gt;ecdc_respicast.py&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;hub ensemble 