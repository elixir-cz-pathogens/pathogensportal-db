<mxfile host="app.diagrams.net" agent="pathogensportal-db docs" version="24.7.5"><diagram id="metadata-flow" name="metadata-flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2040" pageHeight="920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="pathogensportal-db — metadata flow: from the publishers to the &lt;i&gt;meta&lt;/i&gt; block of every chart" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1400" height="40" as="geometry"/></mxCell><mxCell id="bg_a" value="What the publisher says about the data" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#fafafa;strokeColor=#cccccc;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontFamily=Helvetica;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="26" y="196" width="298" height="480" as="geometry"/></mxCell><mxCell id="bg_f" value="Who reads it (portal side)" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#fafafa;strokeColor=#cccccc;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontFamily=Helvetica;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1716" y="196" width="288" height="480" as="geometry"/></mxCell><mxCell id="a_csvw" value='&lt;b&gt;CSVW — *.csv-metadata.json&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;title, description, licence,&lt;br&gt;dc:modified, column list&lt;br&gt;&lt;i&gt;ÚZIS: ISIN, RPN, RTBC&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="270" height="74" as="geometry"/></mxCell><mxCell id="a_nkod" value='&lt;b&gt;NKOD — data.gov.cz (DCAT JSON-LD)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;release periodicity, themes,&lt;br&gt;permanent dataset IRI&lt;br&gt;&lt;i&gt;ÚZIS: ISIN, RPN, RTBC&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="326" width="270" height="74" as="geometry"/></mxCell><mxCell id="a_head" value='&lt;b&gt;HTTP HEAD on the data file&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Last-Modified, ETag, size&lt;br&gt;&lt;i&gt;ÚZIS ×3, MZČR, ČSÚ, WHO&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="412" width="270" height="74" as="geometry"/></mxCell><mxCell id="a_gh" value='&lt;b&gt;GitHub API — last commit&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;commit date = release date&lt;br&gt;&lt;i&gt;ECDC ERVISS, ECDC RespiCast&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="498" width="270" height="74" as="geometry"/></mxCell><mxCell id="a_man" value="&lt;b&gt;manual + manual_note&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;no machine-readable metadata:&lt;br&gt;&lt;i&gt;SZÚ (PDFs), frozen ECDC COVID&lt;/i&gt;&lt;br&gt;the date is our claim, not the source's&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="584" width="270" height="74" as="geometry"/></mxCell><mxCell id="sm" value='&lt;b&gt;source_metadata.py&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;br&gt;called by run_all.py after the snapshot&lt;br&gt;&lt;br&gt;for every record in sources.yaml:&lt;br&gt;try each discovery route on its own&lt;br&gt;&lt;br&gt;the first (richest) answer wins:&lt;br&gt;csvw → nkod → http_head&lt;br&gt;&lt;br&gt;the licence claimed by the source&lt;br&gt;is kept next to ours&lt;br&gt;&lt;br&gt;&lt;b&gt;a failed lookup is written to&lt;/b&gt;&lt;br&gt;&lt;b&gt;errors — it never stops the pipeline&lt;/b&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="400" y="240" width="270" height="418" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.0885;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_csvw" target="sm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2943;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_nkod" target="sm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_head" target="sm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7057;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_gh" target="sm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#b85450;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9115;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_man" target="sm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="reg_src" value='&lt;b&gt;sources.yaml&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;one record per source: id, publisher,&lt;br&gt;landing page, licence, files,&lt;br&gt;methodology ids, discovery routes&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="400" y="84" width="270" height="100" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="reg_src" target="sm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="por_src" value='&lt;b&gt;portal: frontend/data/sources.yaml&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;editorial catalogue for readers&lt;br&gt;(cs/en titles, limits, pages)&lt;br&gt;&lt;i&gt;different file, same id&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="84" width="270" height="100" as="geometry"/></mxCell><mxCell id="e7" value="joined by id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#999999;dashed=1;endArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="por_src" target="reg_src"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="man_f" value='&lt;b&gt;raw/manifest.json&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;written by&lt;br&gt;snapshot.py&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="400" y="730" width="120" height="80" as="geometry"/></mxCell><mxCell id="reg_met" value='&lt;b&gt;methodology_changes.yaml&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;reporting changes that look like&lt;br&gt;epidemics: id, od, akce, popis, dopad&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="550" y="730" width="250" height="80" as="geometry"/></mxCell><mxCell id="e8" value="date we last&lt;br&gt;fetched the file" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#7a7a7a;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.2222;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="man_f" target="sm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="caveats" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=0.24;exitY=0;exitDx=0;exitDy=0;entryX=0.7778;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="reg_met" target="sm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sj" value='&lt;b&gt;$DATA_DIR/meta/&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;b&gt;source_metadata.json&lt;/b&gt;&lt;br&gt;&lt;br&gt;per source id:&lt;br&gt;title · description · publisher&lt;br&gt;landing_page · licence&lt;br&gt;modified_at_publisher&lt;br&gt;modified_source (which route)&lt;br&gt;periodicity · columns · etag&lt;br&gt;fetched_at · snapshot_date&lt;br&gt;caveats [ ]&lt;br&gt;errors { } (only when a route failed)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="300" width="260" height="290" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=1;exitY=0.4904;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sm" target="sj"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cm" value='&lt;b&gt;chart_meta.py&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;br&gt;attach(name, obj)&lt;br&gt;&lt;br&gt;1. look the chart up in charts.yaml&lt;br&gt;(isin_group_* covers a prefix)&lt;br&gt;2. copy metric, unit, grain, region&lt;br&gt;3. read the period from labels&lt;br&gt;(time grains only)&lt;br&gt;4. add the source records + caveats&lt;br&gt;&lt;br&gt;missing inputs → chart is written&lt;br&gt;without meta, with a warning&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1100" y="300" width="250" height="290" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sj" target="cm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="reg_ch" value='&lt;b&gt;charts.yaml&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;one line per chart:&lt;br&gt;source, metric, unit, grain, region&lt;br&gt;(the map a machine needs to read a chart)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1100" y="84" width="250" height="100" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="reg_ch" target="cm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="gen" value='&lt;b&gt;the three generators&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;generate_json.py save() · detect_anomalies.py&lt;br&gt;compute_mem.py&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1090" y="730" width="270" height="80" as="geometry"/></mxCell><mxCell id="e13" value="chart name + payload" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#36546b;exitX=0.3333;exitY=0;exitDx=0;exitDy=0;entryX=0.32;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="gen" target="cm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="payload + meta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=0.72;exitY=1;exitDx=0;exitDy=0;entryX=0.7037;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cm" target="gen"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="baseline rules for the detector" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#b85450;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="reg_met" target="gen"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="js" value='&lt;b&gt;$OUTPUT_DIR/&amp;lt;chart&amp;gt;.json&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Courier New"&gt;{&lt;br&gt;&amp;nbsp;"labels": [...],&lt;br&gt;&amp;nbsp;"datasets": [...],&lt;br&gt;&amp;nbsp;&lt;b&gt;"meta"&lt;/b&gt;: {&lt;br&gt;&amp;nbsp;&amp;nbsp;"chart_id", "generated_at",&lt;br&gt;&amp;nbsp;&amp;nbsp;"metric", "unit",&lt;br&gt;&amp;nbsp;&amp;nbsp;"grain", "region",&lt;br&gt;&amp;nbsp;&amp;nbsp;"period": {start, end, points},&lt;br&gt;&amp;nbsp;&amp;nbsp;"source_ids": [...],&lt;br&gt;&amp;nbsp;&amp;nbsp;"sources": [{id, publisher,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;licence, periodicity,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;modified_at_publisher,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;snapshot_date}],&lt;br&gt;&amp;nbsp;&amp;nbsp;"caveats": [{id, since,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;action, description, impact}]&lt;br&gt;&amp;nbsp;}&lt;br&gt;}&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1420" y="240" width="250" height="410" as="geometry"/></mxCell><mxCell id="e16" value="writes the file" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#36546b;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="gen" target="js"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f_api" value='&lt;b&gt;website-be — /api/charts&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;serves the JSON unchanged&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1730" y="250" width="260" height="84" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=1;exitY=0.1268;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="js" target="f_api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f_mcp" value='&lt;b&gt;MCP server&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;knows unit, period and source&lt;br&gt;of every number&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1730" y="350" width="260" height="84" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=1;exitY=0.3707;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="js" target="f_mcp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f_ai" value='&lt;b&gt;AI layer (llm-agent-be)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;caveats stop it from calling a&lt;br&gt;reporting change an epidemic&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fontFamily=Helvetica;fontSize=12;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1730" y="450" width="260" height="84" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=1;exitY=0.6146;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="js" target="f_ai"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCel